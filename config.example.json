{
  "default_provider": "mock",
  "vision_provider": "gemini_vision",
  "generation": {
    "temperature": 0.2,
    "max_tokens": 4096
  },
  "providers": {
    "mock": {
      "type": "mock",
      "model": "mock-echo"
    },
    "litellm": {
      "type": "litellm",
      "model": "gpt-4o",
      "api_key_env": "OPENAI_API_KEY"
    },
    "azure": {
      "type": "azure",
      "endpoint": "https://YOUR-RESOURCE.openai.azure.com",
      "deployment": "gpt-4o",
      "api_version": "2024-10-21",
      "api_key_env": "AZURE_OPENAI_API_KEY"
    },
    "poe": {
      "type": "poe",
      "model": "GPT-4o",
      "api_key_env": "POE_API_KEY"
    },
    "gemini_vision": {
      "type": "poe",
      "model": "Gemini-3.1-Pro",
      "vision": true,
      "api_key_env": "POE_API_KEY"
    },
    "minimax": {
      "type": "minimax",
      "model": "MiniMax-Text-01",
      "base_url": "https://api.minimaxi.com/v1",
      "api_key_env": "MINIMAX_API_KEY",
      "group_id_env": "MINIMAX_GROUP_ID"
    }
  },
  "evidence": {
    "_comment": "Absent or type=none means NO retrieval happens and every citation is model recall — the run is flagged EVIDENCE_NOT_RETRIEVED. Set type=pubmed to retrieve real identifiers before the reasoning call.",
    "type": "none"
  },
  "consult": {
    "lang": "zh",
    "max_rounds": 6,
    "questions_per_round": 3
  }
}
